# انسخ الملف إلى .env.local للتطوير، أو اضبط المتغيرات في لوحة الاستضافة للإنتاج. لا ترفع القيم الفعلية للمستودع.

# ── للنشر بـ Docker Compose فقط (docker-compose.yml) ──
# الدومين النهائي بدون https:// (مثل imainstream.net). Caddy يصدر شهادة HTTPS له ولـ www تلقائياً
DOMAIN=
# كلمة مرور قاعدة البيانات داخل Docker. ولّدها بـ: openssl rand -base64 32
POSTGRES_PASSWORD=
# مع Docker Compose تُضبط DATABASE_URL و SITE_URL و UPLOAD_DIR تلقائياً، فاتركها فاضية.

# رابط قاعدة PostgreSQL (استخدم قاعدة مختلفة لكل بيئة: تطوير / تجربة / إنتاج)
DATABASE_URL=

# مفتاح سري عشوائي (32 حرف أو أكثر) لتوقيع رسائل اللوحة وبصمات العناوين. ولّده بـ: openssl rand -base64 48
APP_SECRET=

# الرابط العام للموقع بدون شرطة في النهاية (يُستخدم في canonical و sitemap وروابط الإيميل)
SITE_URL=

# ضع 1 في بيئة التجربة لمنع محركات البحث من فهرستها
SITE_NOINDEX=

# بريد التنبيهات (SMTP). المنفذ الافتراضي 587 (أو 465 لـ SSL). إذا تُرك فارغاً تُحفظ الطلبات وتظهر التنبيهات "فشلت" في اللوحة مع زر إعادة المحاولة
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# بريد استقبال التنبيهات الافتراضي (يمكن تغييره من اللوحة: الإعدادات)
NOTIFY_EMAIL=

# مجلد حفظ الصور والفيديوهات المرفوعة من اللوحة (يجب أن يكون دائماً ومشمولاً بالنسخ الاحتياطي)
UPLOAD_DIR=

# للتشغيل المحلي على http فقط: ضع 1 حتى تعمل ملفات الجلسة بدون HTTPS. لا تستخدمه في الإنتاج
INSECURE_COOKIES=
